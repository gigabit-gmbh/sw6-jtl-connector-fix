<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Shopware\Core\Framework\Api\Controller\ApiController"
                 class="GigabitIo\JtlConnectorFix\Api\ApiControllerOverride"
                 autowire="true" autoconfigure="true" public="true"/>
        <service id="Shopware\Core\Framework\Api\Controller\SyncController"
                 class="GigabitIo\JtlConnectorFix\Api\SyncControllerOverride"
                 autowire="true" autoconfigure="true" public="true">
            <argument type="service" id="Shopware\Core\Framework\Api\Sync\SyncService"/>
            <argument type="service" id="serializer"/>
        </service>
    </services>
</container>
